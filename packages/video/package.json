{
	"name": "@clipify/video",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"flow:audio": "bun scripts/clipify-flow/generate-soundtrack.mjs",
		"flow:review:social": "bun scripts/clipify-flow/review-social.mjs",
		"flow:preview": "remotion render src/index.ts ClipifyFlow out/clipify-flow-preview.mp4 --concurrency=4 --scale=0.5 --codec=h264 --crf=20 --pixel-format=yuv420p --color-space=bt709 --audio-bitrate=256K",
		"flow:render": "remotion render src/index.ts ClipifyFlow out/clipify-flow.mp4 --concurrency=4 --codec=h264 --crf=14 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"flow:master": "remotion render src/index.ts ClipifyFlow out/clipify-flow-master.mov --concurrency=4 --codec=prores --prores-profile=4444 --pixel-format=yuv444p10le --image-format=png --color-space=bt709",
		"rebuilt:audio": "bun scripts/clipify-rebuilt/generate-soundtrack.mjs",
		"rebuilt:master": "remotion render src/index.ts ClipifyRebuilt out/clipify-rebuilt-master.mov --concurrency=4 --codec=prores --prores-profile=4444 --pixel-format=yuv444p10le --image-format=png --color-space=bt709",
		"rebuilt:render": "remotion render src/index.ts ClipifyRebuilt out/clipify-rebuilt.mp4 --concurrency=4 --codec=h264 --crf=14 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"rebuilt:preview": "remotion render src/index.ts ClipifyRebuilt out/clipify-rebuilt-preview.mp4 --concurrency=4 --scale=0.5 --codec=h264 --crf=20 --pixel-format=yuv420p --color-space=bt709 --audio-bitrate=256K",
		"moments:trailer:audio": "bun scripts/moments-trailer/generate-soundtrack.mjs",
		"moments:trailer:preview": "remotion render src/index.ts MomentsTrailer out/your-last-stream-rough-cut.mp4 --concurrency=4 --codec=h264 --crf=16 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"moments:audio": "bun scripts/moments-preview/generate-soundtrack.mjs",
		"moments:preview": "remotion render src/index.ts MomentsPreview out/moments-music-motion-preview.mp4 --concurrency=4 --codec=h264 --crf=16 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"audio:generate": "bun scripts/clipify-showcase/generate-soundtrack.mjs",
		"pulse:audio": "bun scripts/clipify-pulse/generate-soundtrack.mjs",
		"pulse:render": "remotion render src/index.ts ClipifyPulse out/clipify-pulse-master.mov --concurrency=4 --codec=prores --prores-profile=4444 --pixel-format=yuv444p10le --image-format=png --color-space=bt709",
		"pulse:render:upload": "remotion render src/index.ts ClipifyPulse out/clipify-pulse-upload.mp4 --concurrency=4 --codec=h264 --crf=12 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"pulse:render:preview": "remotion render src/index.ts ClipifyPulse out/clipify-pulse-preview.mp4 --concurrency=4 --hardware-acceleration=if-possible --video-bitrate=6M",
		"pulse:thumbnail": "remotion still src/index.ts ClipifyPulse out/clipify-pulse-thumbnail.png --frame=664",
		"studio": "remotion studio src/index.ts",
		"render": "remotion render src/index.ts ClipifyShowcase out/clipify-showcase-master.mov --concurrency=4 --codec=prores --prores-profile=4444 --pixel-format=yuv444p10le --image-format=png --color-space=bt709",
		"render:vertical": "remotion render src/index.ts ClipifyShowcaseVertical out/clipify-showcase-vertical-master.mov --concurrency=4 --codec=prores --prores-profile=4444 --pixel-format=yuv444p10le --image-format=png --color-space=bt709",
		"render:feed": "remotion render src/index.ts ClipifyShowcaseFeed out/clipify-showcase-feed-master.mov --concurrency=4 --codec=prores --prores-profile=4444 --pixel-format=yuv444p10le --image-format=png --color-space=bt709",
		"render:upload": "remotion render src/index.ts ClipifyShowcase out/clipify-showcase-upload.mp4 --concurrency=4 --codec=h264 --crf=12 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"render:upload:vertical": "remotion render src/index.ts ClipifyShowcaseVertical out/clipify-showcase-vertical-upload.mp4 --concurrency=4 --codec=h264 --crf=12 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"render:upload:feed": "remotion render src/index.ts ClipifyShowcaseFeed out/clipify-showcase-feed-upload.mp4 --concurrency=4 --codec=h264 --crf=12 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"render:preview": "remotion render src/index.ts ClipifyShowcase out/clipify-showcase-preview.mp4 --concurrency=4 --hardware-acceleration=if-possible --video-bitrate=6M",
		"render:preview:vertical": "remotion render src/index.ts ClipifyShowcaseVertical out/clipify-showcase-vertical-preview.mp4 --concurrency=4 --hardware-acceleration=if-possible --video-bitrate=6M",
		"render:preview:feed": "remotion render src/index.ts ClipifyShowcaseFeed out/clipify-showcase-feed-preview.mp4 --concurrency=4 --hardware-acceleration=if-possible --video-bitrate=6M",
		"thumbnail": "remotion still src/index.ts ClipifyShowcase out/clipify-showcase-thumbnail.png --frame=1230",
		"thumbnail:vertical": "remotion still src/index.ts ClipifyShowcaseVertical out/clipify-showcase-vertical-thumbnail.png --frame=1230",
		"thumbnail:feed": "remotion still src/index.ts ClipifyShowcaseFeed out/clipify-showcase-feed-thumbnail.png --frame=1230",
		"typecheck": "tsc --noEmit",
		"flow:preview:vertical": "remotion render src/index.ts ClipifyFlowVertical out/clipify-flow-vertical-preview.mp4 --concurrency=4 --scale=0.5 --codec=h264 --crf=20 --pixel-format=yuv420p --color-space=bt709 --audio-bitrate=256K",
		"flow:render:vertical": "remotion render src/index.ts ClipifyFlowVertical out/clipify-flow-vertical.mp4 --concurrency=4 --codec=h264 --crf=14 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"flow:master:vertical": "remotion render src/index.ts ClipifyFlowVertical out/clipify-flow-vertical-master.mov --concurrency=4 --codec=prores --prores-profile=4444 --pixel-format=yuv444p10le --image-format=png --color-space=bt709",
		"flow:thumbnail:vertical": "remotion still src/index.ts ClipifyFlowVertical out/clipify-flow-vertical-thumbnail.png --frame=900",
		"flow:preview:feed": "remotion render src/index.ts ClipifyFlowFeed out/clipify-flow-feed-preview.mp4 --concurrency=4 --scale=0.5 --codec=h264 --crf=20 --pixel-format=yuv420p --color-space=bt709 --audio-bitrate=256K",
		"flow:render:feed": "remotion render src/index.ts ClipifyFlowFeed out/clipify-flow-feed.mp4 --concurrency=4 --codec=h264 --crf=14 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"flow:master:feed": "remotion render src/index.ts ClipifyFlowFeed out/clipify-flow-feed-master.mov --concurrency=4 --codec=prores --prores-profile=4444 --pixel-format=yuv444p10le --image-format=png --color-space=bt709",
		"flow:thumbnail:feed": "remotion still src/index.ts ClipifyFlowFeed out/clipify-flow-feed-thumbnail.png --frame=900",
		"flow:thumbnail": "remotion still src/index.ts ClipifyFlow out/clipify-flow-thumbnail.png --frame=900",
		"fonts:prepare": "bun scripts/prepare-fonts.mjs"
	},
	"dependencies": {
		"@tabler/icons-react": "3.50.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"remotion": "4.0.541"
	},
	"devDependencies": {
		"@remotion/cli": "4.0.541",
		"@types/react": "19.3.0",
		"typescript": "6.0.3"
	}
