{
	"name": "@clipify/video",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"audio:generate": "bun scripts/clipify-showcase/generate-soundtrack.mjs",
		"studio": "remotion studio src/index.ts",
		"render": "remotion render src/index.ts ClipifyShowcase out/clipify-showcase-master.mov --concurrency=4 --codec=prores --prores-profile=4444 --pixel-format=yuv444p10le --image-format=png --color-space=bt709",
		"render:vertical": "remotion render src/index.ts ClipifyShowcaseVertical out/clipify-showcase-vertical-master.mov --concurrency=4 --codec=prores --prores-profile=4444 --pixel-format=yuv444p10le --image-format=png --color-space=bt709",
		"render:feed": "remotion render src/index.ts ClipifyShowcaseFeed out/clipify-showcase-feed-master.mov --concurrency=4 --codec=prores --prores-profile=4444 --pixel-format=yuv444p10le --image-format=png --color-space=bt709",
		"render:upload": "remotion render src/index.ts ClipifyShowcase out/clipify-showcase-upload.mp4 --concurrency=4 --codec=h264 --crf=12 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"render:upload:vertical": "remotion render src/index.ts ClipifyShowcaseVertical out/clipify-showcase-vertical-upload.mp4 --concurrency=4 --codec=h264 --crf=12 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"render:upload:feed": "remotion render src/index.ts ClipifyShowcaseFeed out/clipify-showcase-feed-upload.mp4 --concurrency=4 --codec=h264 --crf=12 --pixel-format=yuv420p --image-format=png --color-space=bt709 --audio-bitrate=320K",
		"render:preview": "remotion render src/index.ts ClipifyShowcase out/clipify-showcase-preview.mp4 --concurrency=4 --hardware-acceleration=if-possible --video-bitrate=6M",
		"render:preview:vertical": "remotion render src/index.ts ClipifyShowcaseVertical out/clipify-showcase-vertical-preview.mp4 --concurrency=4 --hardware-acceleration=if-possible --video-bitrate=6M",
		"render:preview:feed": "remotion render src/index.ts ClipifyShowcaseFeed out/clipify-showcase-feed-preview.mp4 --concurrency=4 --hardware-acceleration=if-possible --video-bitrate=6M",
		"thumbnail": "remotion still src/index.ts ClipifyShowcase out/clipify-showcase-thumbnail.png --frame=1230",
		"thumbnail:vertical": "remotion still src/index.ts ClipifyShowcaseVertical out/clipify-showcase-vertical-thumbnail.png --frame=1230",
		"thumbnail:feed": "remotion still src/index.ts ClipifyShowcaseFeed out/clipify-showcase-feed-thumbnail.png --frame=1230",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tabler/icons-react": "3.47.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"remotion": "4.0.529"
	},
	"devDependencies": {
		"@remotion/cli": "4.0.529",
		"@types/react": "19.2.14",
		"typescript": "7.0.2"
	}
}
