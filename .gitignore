# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/compliance-results/
/blob-report/
/.features-gen/

# next.js
/.next/
/.next-playwright/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.session.sql
.secrets
/logs/
runner.log
/public/downloads/runner/

# Graphify: keep the shareable graph/report, keep local state out of Git
/graphify-out/cache/
/graphify-out/memory/
/graphify-out/reflections/
/graphify-out/converted/
/graphify-out/.graphify_*
/graphify-out/.vocab.txt
/graphify-out/manifest.json
/graphify-out/cost.json
/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Isolated Runner dependencies
/packages/runner/node_modules/
