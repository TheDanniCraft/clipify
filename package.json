{
	"name": "clipify",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"app:dev": "RUNNER_ARTIFACT_SOURCE=local infisical run --env=dev --watch -- next dev",
		"app:webhook": "stripe listen --forward-to localhost:3000/payment/webhook",
		"app:eventsub": "ngrok http 3000 --url https://well-free-wildcat.ngrok-free.app",
		"app:build": "node scripts/build-app.mjs",
		"app:check-action-manifest": "node scripts/check-server-action-manifest.mjs",
		"app:start": "next start",
		"app:lint": "eslint .",
		"app:prettier": "prettier --write .",
		"patches:validate": "bun scripts/validate-patched-dependencies.ts",
		"git:staged": "lint-staged",
		"app:typecheck": "tsc --noEmit",
		"test": "jest --runInBand",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage --runInBand",
		"db:push": "infisical run --env=dev -- drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "infisical run --env=dev -- drizzle-kit studio",
		"prepare": "next-ws patch && husky",
		"runner:dev": "tsx watch packages/runner/src/index.ts",
		"runner:build": "NODE_ENV=development bun packages/runner/build.mjs",
		"stream:test": "tsx scripts/stream-test.ts"
	},
	"dependencies": {
		"@heroui-pro/react": "^1.0.0-beta.8",
		"@heroui/react": "^3.2.4",
		"@heroui/styles": "^3.2.4",
		"@number-flow/react": ">=0.6.2",
		"@react-aria/utils": ">=3.34.1",
		"@sentry/nextjs": "^10.70.0",
		"@tabler/icons-react": "^3.46.0",
		"@tiptap/core": ">=3.30.2",
		"@tiptap/extension-link": ">=3.30.2",
		"@tiptap/extension-underline": ">=3.30.2",
		"@tiptap/extensions": ">=3.30.2",
		"@tiptap/pm": ">=3.23.6",
		"@tiptap/react": ">=3.30.2",
		"@tiptap/starter-kit": ">=3.23.6",
		"@tiptap/suggestion": ">=3.23.6",
		"@types/ffbinaries": "^1.1.5",
		"axios": "^1.19.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"embla-carousel": ">=8.6.0",
		"embla-carousel-react": ">=8.6.0",
		"fluent-ffmpeg": "^2.1.3",
		"jsonwebtoken": "^9.0.3",
		"maplibre-gl": ">=6.0.0",
		"marked": ">=18.0.10",
		"minimatch": "^10.2.6",
		"motion": "^13.1.1",
		"next": "^16.3.1",
		"next-navigation-guard": "^0.2.0",
		"next-plausible": "^4.0.0",
		"next-themes": "^0.4.6",
		"next-ws": "^2.2.11",
		"nextjs-turnstile": "^1.0.5",
		"pg": "^8.23.0",
		"rate-limiter-flexible": "^11.2.0",
		"re2js": "^2.8.6",
		"react": "^19.2.8",
		"react-aria-components": ">=1.19.0",
		"react-dom": "^19.2.8",
		"react-markdown": ">=10.1.0",
		"react-resizable-panels": ">=4.10.0",
		"recharts": "^3.10.1",
		"remark-breaks": ">=4.0.0",
		"remark-gfm": ">=4.0.1",
		"shiki": ">=4.0.0",
		"streamdown": ">=2.5.0",
		"stripe": "^22.5.0",
		"tailwind-merge": ">=3.4.0",
		"tailwind-variants": "^3.3.1",
		"usesend-js": "^1.6.3",
		"ws": "^8.21.3",
		"xss": "^1.0.15"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.5",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/ws": "^8.18.1",
		"@vercel/nft": "^1.11.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.3.1",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"@types/node-media-server": "^2.3.7"
	},
	"patchedDependencies": {
		"next@16.3.1": "patches/next.patch"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,md}": [
			"prettier --write"
		]
	},
	"trustedDependencies": [
		"heroui-pro",
		"@heroui-pro/react",
		"heroui-native-pro"
	]
}
